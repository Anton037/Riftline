{
  "name": "riftline",
  "version": "3.63.1",
  "private": true,
  "type": "module",
  "description": "Riftline – a touch-only 3D arena roguelite shooter for phones and tablets in landscape (three.js, WebAudio).",
  "homepage": "https://anton037.github.io/Riftline/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anton037/Riftline.git"
  },
  "riftline": {
    "build": "r3631a1106a-r1"
  },
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "serve": "node tools/serve.js",
    "test": "node tools/test.js",
    "check": "node tools/check.js",
    "probe:audio": "node tools/verify.js probe-audio",
    "probe:mix": "node tools/verify.js mix",
    "probe:music": "node tools/verify.js music",
    "probe:place": "node tools/verify.js place",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.mjs\" \"tools/**/*.{js,mjs}\" \"scripts/**/*.mjs\" build.js eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.mjs\" \"tools/**/*.{js,mjs}\" \"scripts/**/*.mjs\" build.js eslint.config.mjs",
    "lint": "eslint .",
    "test:unit": "node tools/test.js --unit",
    "e2e": "node tools/test.js --browser",
    "test:render": "node tools/test.js --browser --draw",
    "release-check": "node tools/check.js",
    "audit:visual": "node tools/verify.js visual current tablet && node tools/verify.js visual current land",
    "verify:audio": "node tools/verify.js audio",
    "verify:audio-budget": "node tools/verify.js audio-budget"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    }
  }
}
