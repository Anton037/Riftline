{
  "name": "riftline",
  "version": "3.61.0",
  "private": true,
  "type": "module",
  "description": "Riftline – a 3D arena roguelite shooter for the browser (three.js, WebAudio), playable on desktop and on phones and tablets in landscape.",
  "homepage": "https://aaron40776.github.io/Riftline/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aaron40776/Riftline.git"
  },
  "riftline": {
    "build": "r3610a1103a-r1"
  },
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "serve": "node tools/serve.js",
    "test": "node tools/test.js",
    "check": "node tools/check.js",
    "probe:audio": "node build.js && node scripts/rl-audio-check.mjs",
    "probe:mix": "node build.js && node scripts/rl-mix-probe.mjs",
    "probe:music": "node build.js && node scripts/rl-music-probe.mjs",
    "probe:place": "node build.js && node scripts/rl-place-peaks.mjs",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.mjs\" \"tools/**/*.{js,mjs}\" build.js",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.mjs\" \"tools/**/*.{js,mjs}\" build.js",
    "lint": "eslint .",
    "test:unit": "node tools/test.js --unit",
    "e2e": "node tools/test.js --browser",
    "test:render": "node tools/test.js --browser --draw",
    "release-check": "node tools/check.js",
    "audit:visual": "node tools/verify.js visual current pc && node tools/verify.js visual current land",
    "verify:audio": "node tools/verify.js audio",
    "verify:audio-budget": "node tools/verify.js audio-budget"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.56.1",
    "prettier": "3.8.1"
  },
  "dependencies": {
    "three": "0.186.0"
  }
}
